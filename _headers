# Cloudflare Pages headers shared by synthfit.online, yoga. and flowarts. (copied into each site).
# Match what GitHub Pages effectively does today, plus long caching for hashed assets.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/registerSW.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/tv.html
  Cache-Control: no-cache

/hosts.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

/.well-known/*
  Access-Control-Allow-Origin: *
  Content-Type: application/json
